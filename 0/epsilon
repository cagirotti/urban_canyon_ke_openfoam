FoamFile
{
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.001;  // Ajuste conforme necessário

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.001;  // Ajuste conforme necessário
    }

    outlet
    {
        type            zeroGradient;
    }


    frontAndBack
    {
        type            symmetry;
    }

    H45_W15_0
    {
        type            epsilonWallFunction;
        value           uniform 0;
    }
}

